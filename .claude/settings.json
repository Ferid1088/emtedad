{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./resources/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)",
      "Bash(gh repo:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X DELETE:*)",
      "Bash(youtube-dl:*)",
      "Bash(yt-dlp:*)",
      "Bash(alembic:*)",
      "Bash(.venv/bin/python -m app.cli strategy reset:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ],
    "allow": [
      "Bash(.venv/bin/python -m app.cli:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/mypy:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
