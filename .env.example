# Local development values only. Do not reuse these credentials in production.
EMTEDAD_ENVIRONMENT=development
EMTEDAD_DATABASE_URL=postgresql+psycopg://emtedad:local-development-only@127.0.0.1:5432/emtedad
EMTEDAD_STORAGE_ROOT=/tmp/emtedad-storage
EMTEDAD_LOG_LEVEL=INFO
EMTEDAD_LOG_JSON=true

POSTGRES_DB=emtedad
POSTGRES_USER=emtedad
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432


# Devin Cloud REST API — opt-in only for development/tests/manual ops.
# Without EMTEDAD_ALLOW_DEVIN_RUNTIME_FALLBACK=true, role-less or unrouted
# resolution fails closed instead of silently using Devin.
# Generate a key in the Devin dashboard; never commit real tokens.
EMTEDAD_DEVIN_API_KEY=
# EMTEDAD_LLM_PROVIDER=devin
# EMTEDAD_ALLOW_DEVIN_RUNTIME_FALLBACK=false

# APIMaster — the canonical external LLM gateway. Role-based routing
# resolves AgentRoles to these marketplace model IDs (verified against
# GET https://apimaster.ai/v1/models\). Provider-namespaced IDs
# (openai/..., google/...) are used because only they return provider-
# reported cost (see docs/audits/APIMASTER_CERTIFICATION.md).
# Production enables routing:
# EMTEDAD_LLM_ROUTING_ENABLED=true
EMTEDAD_APIMASTER_API_KEY=
# EMTEDAD_APIMASTER_BASE_URL=https://apimaster.ai/v1
# EMTEDAD_MODEL_ROLE_HIGH_VOLUME=qwen3.8-flash
# EMTEDAD_MODEL_ROLE_REASONING=openai/gpt-6.1-sol
# EMTEDAD_MODEL_ROLE_EDITORIAL=google/gemini-3.8-flash
# EMTEDAD_MODEL_ROLE_PREMIUM=openai/gpt-6-astra

# Local YouTube MCP server (streamable-http). Start with:
#   uvx --from yt-mcp-server youtube-mcp-server --transport streamable-http --port 8790
# EMTEDAD_YOUTUBE_MCP_ENABLED=true
# EMTEDAD_YOUTUBE_MCP_URL=http://127.0.0.1:8790
# EMTEDAD_YOUTUBE_MCP_TIMEOUT_SECONDS=60
