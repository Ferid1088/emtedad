  "expected_page_count": 146,
  "concepts": [
    {"stable_key":"emtedad","definition":"پیوستگی چیزی پیش از موجود تا موجود و از اثرهای موجود به آینده؛ امتداد با تکرار یکی نیست.","page":132,"anchor":"امتداد :پیوستگی"},
    {"stable_key":"bon","definition":"تعین بنیادین و یگانه‌ای که امتداد در یک موجود مشخص می‌یابد؛ اشاره به «این موجود بودن»، نه فهرست صفات او.","page":132,"anchor":"ُب ن :تعین بنیادین"},
    {"stable_key":"jan","definition":"در موجود زنده، نام نسبت بُن با زنده‌بودن؛ نه مترادف هوش، آگاهی یا خودآگاهی و نه جایگزین زیست‌شناسی.","page":132,"anchor":"جان :در موجود زنده"},
    {"stable_key":"awareness","definition":"آگاهی زیسته: وجود تجربهٔ اول‌شخص؛ اینکه برای موجود چیزی «چگونه بودن» داشته باشد.","page":135,"anchor":"آگاهی زیسته :وجود"},
    {"stable_key":"self_awareness","definition":"توان بازنمایی بخشی از وضعیت، مرز، تاریخ، ظرفیت، عمل یا شناخت خود به شکلی که در پاسخ سهم داشته باشد.","page":135,"anchor":"خودآگاهی :توان"},
    {"stable_key":"tahigah","definition":"جای باز پرسش «من چه هستم؟» که پاسخ آن از پیش توسط آیین یا دیگری پر نمی‌شود.","page":132,"anchor":"تهیگاه :جای باز"},
    {"stable_key":"conditions","definition":"میدان وسیع چیزهایی که در زندگی حضور دارند و می‌توانند زمینهٔ رخدادها و پاسخ‌ها باشند.","page":132,"anchor":"شرایط :میدان وسیع"},
    {"stable_key":"factor","definition":"چیزی که در یک موضوع مشخص با شکل‌گیری، فعال‌شدن یا ادامهٔ وضعیت یا الگو مرتبط دانسته می‌شود؛ ثبت عامل به‌خودی‌خود اثبات علیت علمی نیست.","page":132,"anchor":"عامل :چیزی که"},
    {"stable_key":"pattern","definition":"فرایند یا پاسخ تکرارشونده و قابل نمونه در موقعیت‌های مشخص.","page":133,"anchor":"الگو :فرایند"},
    {"stable_key":"direction","definition":"چیزی که تلاش را برای شخص ارزشمند می‌کند؛ می‌تواند نزدیک‌شدن به چیزی یا دورشدن از چیزی باشد.","page":133,"anchor":"جهت :چیزی که"},
    {"stable_key":"majal","definition":"گشودگی فرایند پاسخ از انحصار الگو یا فشار مسلط در یک موقعیت مشخص؛ نه آزادی از علیت و نه تعداد گزینه‌ها.","page":133,"anchor":"مجال :گشودگی"},
    {"stable_key":"change","definition":"تغییر می‌تواند در پاسخ، در شرایط جاری یا در هر دو رخ دهد.","page":136,"anchor":"تغییر می تواند در پاسخ"},
    {"stable_key":"suffering","definition":"رنج مستقیم با واقعیت جاری مرتبط است؛ رنج الگومند از فرایندهای تکرارشونده‌ای اثر می‌گیرد که در شکل‌گیری یا ادامهٔ آن سهم دارند.","page":134,"anchor":"رنج مستقیم :رنجی"},
    {"stable_key":"vitality","definition":"لحظه یا تجربه‌ای که حضور و ارزش زندگی را بی‌واسطه برجسته می‌کند.","page":134,"anchor":"سرزندگی مستقیم :لحظه"},
    {"stable_key":"acceptance","definition":"دیدن اینکه چیزی اکنون هست، بدون نتیجه‌گیری اینکه باید باشد.","page":134,"anchor":"پذیرش :دیدن"},
    {"stable_key":"other","definition":"مرکز یگانهٔ دیگری که به نقش او در داستان من فروکاستنی نیست.","page":134,"anchor":"دیگری :مرکز"},
    {"stable_key":"between","definition":"کیفیت یا الگویی که در رابطه شکل می‌گیرد و تماماً متعلق به هیچ‌یک از دو سوی رابطه نیست.","page":134,"anchor":"میان :کیفیت"},
    {"stable_key":"ethics_of_majal","definition":"جهت اخلاقی‌ای که کاهش رنج قابل کاهش، پرهیز از رنج اضافی و بازکردن مجال را همراه با حفاظت از مجال و حقوق دیگران دنبال می‌کند.","page":134,"anchor":"اخلاق مجال :جهت"},
    {"stable_key":"emergence","definition":"پدیدارشدن الگو یا قابلیتی در مقیاس کل از تعامل اجزا، به‌گونه‌ای که آن الگو به همان صورت به یک جزء منفرد نسبت داده نمی‌شود.","page":135,"anchor":"برآمدگی :پدیدارشدن"},
    {"stable_key":"causality","definition":"برای توضیح تغییر لازم نیست گسستی از علیت فرض شود؛ علت‌مندبودن تغییر آن را غیرواقعی نمی‌کند.","page":62,"anchor":"پاسخ سطح عمومی آیین"}
  ],
